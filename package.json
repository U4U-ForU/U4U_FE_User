{
  "name": "u4u",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @u4u/user dev",
    "dev:admin": "bun run --filter @u4u/admin dev",
    "build": "bun run --filter '*' build",
    "lint": "bun run --filter '*' lint"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
